# このファイルをコピーして .env を作成し、実際の値を入力する。
# .env はGitにコミットしない(.gitignore対象)。

DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_db_user
DB_PASS=your_db_password

# CORSを許可するオリジン。複数はカンマ区切り。本番はダッシュボードと同一オリジンなので基本不要、
# ローカル開発時(npm run dev)からの動作確認用にlocalhostを入れておくと便利
PUBLIC_CORS_ORIGINS=http://localhost:5173

# パスワードリセットメールのリンク生成に使う、ダッシュボードのベースURL(末尾スラッシュ無し)
APP_BASE_URL=https://workout.tamachan-blog.com

# Google Cloud ConsoleでOAuth 2.0クライアント(ウェブアプリケーション種別)を作成して設定する。
# リダイレクトURIは "{APP_BASE_URL}/api/auth/google_callback.php" を登録する
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://workout.tamachan-blog.com/api/auth/google_callback.php

# パスワードリセットメールのFromアドレス。XServerのメール機能で作成したアカウントを指定する
MAIL_FROM=noreply@workout.tamachan-blog.com
