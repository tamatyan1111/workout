# このファイルをコピーして .env を作成し、実際の値を入力する。
# .env はGitにコミットしない(.gitignore対象)。

DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_db_user
DB_PASS=your_db_password

# CORSを許可するオリジン。複数はカンマ区切り。本番は公開サイトと同一オリジンなので基本不要、
# ローカル開発時(npm run dev)からの動作確認用にlocalhostを入れておくと便利
PUBLIC_CORS_ORIGINS=http://localhost:5173
